<mxfile host="app.diagrams.net" modified="2026-07-26T00:00:00.000Z" agent="Codex" version="30.0.4">
  <diagram id="context-aware-task-core-flow" name="上下文感知任务协作流程">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="先智能完善任务，Agent 执行按需开启" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="940" height="40" as="geometry"/></mxCell>
        <mxCell id="step-1" value="打开已有任务&#xa;保留标题与来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="135" height="100" as="geometry"/></mxCell>
        <mxCell id="step-2" value="装配授权上下文&#xa;展示来源清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="190" width="135" height="100" as="geometry"/></mxCell>
        <mxCell id="decision-1" value="足以明确下一步&#xa;且无关键冲突？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7db;strokeColor=#d8a437;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="140" height="100" as="geometry"/></mxCell>
        <mxCell id="step-3" value="生成任务简报&#xa;事实 · 推断 · 缺失" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7db;strokeColor=#d8a437;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="190" width="140" height="100" as="geometry"/></mxCell>
        <mxCell id="decision-2" value="用户确认&#xa;任务简报？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7db;strokeColor=#d8a437;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="190" width="140" height="100" as="geometry"/></mxCell>
        <mxCell id="step-4" value="保存任务简报&#xa;不改变看板状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff4e6;strokeColor=#2e9c61;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="835" y="190" width="145" height="100" as="geometry"/></mxCell>
        <mxCell id="decision-3" value="现在交给&#xa;Agent？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f2f3f5;strokeColor=#7b8494;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1005" y="190" width="140" height="100" as="geometry"/></mxCell>
        <mxCell id="step-5" value="选择 Agent / 工作区&#xa;确认执行包与权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7db;strokeColor=#d8a437;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="190" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="step-6" value="创建并追踪会话&#xa;Codex / Claude Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#5b8def;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1345" y="190" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="step-7" value="结果回写与人工验收&#xa;完成 · 返工 · 复盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff4e6;strokeColor=#2e9c61;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1520" y="190" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="branch-1" value="按需对话&#xa;只追问阻断性缺口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe5e1;strokeColor=#c65d4d;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="335" y="390" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="branch-2" value="人工解决冲突&#xa;选择可信来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe5e1;strokeColor=#c65d4d;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="335" y="70" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="branch-3" value="编辑或重新生成&#xa;暂不保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe5e1;strokeColor=#c65d4d;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="660" y="390" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="manual" value="返回 TaskNotes&#xa;人工排期 · 推进 · 完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff4e6;strokeColor=#2e9c61;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985" y="390" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="branch-4" value="运行时不可用&#xa;打开工作区 + 人工交接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe5e1;strokeColor=#c65d4d;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1170" y="510" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="branch-5" value="验收不通过&#xa;继续原会话并保留历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe5e1;strokeColor=#c65d4d;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1455" y="390" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="support" value="主链路完成条件：任务简报已保存。Agent 是可选分支，不是任务澄清的准入门槛；上下文始终可见、可排除、可追溯。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1b8;strokeColor=#d8a437;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="335" y="650" width="1130" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4e7fd1;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="step-1" target="step-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4e7fd1;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="step-2" target="decision-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d8a437;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="decision-1" target="step-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d8a437;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="step-3" target="decision-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="确认" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e9c61;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="decision-2" target="step-4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e9c61;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="step-4" target="decision-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7b8494;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="decision-3" target="step-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4e7fd1;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="step-5" target="step-6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e9c61;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="step-6" target="step-7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="信息不足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="decision-1" target="branch-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="补充后重试" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="branch-1" target="step-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="存在冲突" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="decision-1" target="branch-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="解决后重试" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="branch-2" target="step-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="未确认" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="decision-2" target="branch-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="更新草稿" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="branch-3" target="step-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="否 / 稍后再说" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e9c61;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="decision-3" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="不可用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="step-5" target="branch-4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="验收不通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="step-7" target="branch-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="继续执行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c65d4d;strokeWidth=2.5;endArrow=block;fontSize=15;" edge="1" parent="1" source="branch-5" target="step-6"><mxGeometry relative="1" as="geometry"/></mxCell>
